      "endpoint": "/products"
    },
    "FunctionalTestCase-API-AUTH-011": {
      "testCaseId": "FunctionalTestCase-API-AUTH-011",
      "module": "API User Authentication",
      "suiteType": "E2E",
      "layer": "api",
      "dataFile": "API/testdata/login.json",
      "dataKey": "customer",
      "flow": [
        {
          "step": 1,
          "method": "POST",
          "endpoint": "/users/login",
          "payloadKey": "customer",
          "expectedStatus": 200,
          "extract": "access_token"
        },
        {
          "step": 2,
          "method": "GET",
          "endpoint": "/users/me",
          "auth": "Bearer",
          "expectedStatus": 200,
          "assertProfileEmailFrom": "customer.email"
        },
        {
          "step": 3,
          "method": "GET",
          "endpoint": "/users/logout",
          "auth": "Bearer",
          "expectedStatus": 200,
          "expectedMessage": "Successfully logged out"
        }
      ]
    }
  }
}
