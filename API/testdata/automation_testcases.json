    "FunctionalTestCase-API-AUTH-001": {
      "testCaseId": "FunctionalTestCase-API-AUTH-001",
      "module": "API User Authentication",
      "suiteType": "Smoke",
      "layer": "api",
      "dataFile": "API/testdata/login.json",
      "dataKey": "customer",
      "endpoint": "/users/login",
      "expectedStatus": 200,
      "expectedResponseFields": ["access_token", "token_type", "expires_in"],
      "expectedTokenType": "bearer"
    },
    "FunctionalTestCase-API-CART-001": {
      "testCaseId": "FunctionalTestCase-API-CART-001",
